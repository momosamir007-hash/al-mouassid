# قاعدة البيانات
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# سر التشفير لمفاتيح المزودين المخزنة في القاعدة (AES-256-GCM). أنشئه بـ: openssl rand -hex 32
APP_SECRET=

# مفاتيح المزودين (اختيارية؛ تُقرأ على الخادم فقط ولا تصل للمتصفح أبداً)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama المحلي (على خادم المنصة)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# سياسة التوجيه: quality (الجودة أولاً) | cost (المحلي/الأرخص أولاً) | speed (الأسرع أولاً)
AI_ROUTING_POLICY=quality

# بريد يُمنح دور المدير عند التسجيل (اختياري). أول حساب يُسجَّل يصبح مديراً تلقائياً.
ADMIN_EMAIL=
